{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git blame*)",
      "Bash(git show*)",
      "Bash(git check-ignore*)",
      "Bash(npm ci)",
      "Bash(npm run copy:check*)",
      "Bash(npm run build*)",
      "Bash(node scripts/edit-copy.mjs --check*)"
    ],
    "ask": [
      "Agent(system-architect)",
      "Agent(critical-architect)",
      "Agent(fable-strategist)",
      "Agent(fable-rescue)",
      "Agent(standard-reviewer)",
      "Agent(critical-reviewer)"
    ],
    "deny": [
      "Read(./.env*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/orchestration/scripts/readonly-edit-guard.mjs\" || true",
            "timeout": 10
          }
        ],
        "matcher": "Edit|Write|MultiEdit|NotebookEdit"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/orchestration/scripts/readonly-bash-guard.mjs\" || true",
            "timeout": 10
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/orchestration/scripts/fable-gate.mjs\" || true",
            "timeout": 10
          }
        ],
        "matcher": "Agent"
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/orchestration/scripts/lifecycle-log.mjs\" || true",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/orchestration/scripts/lifecycle-log.mjs\" || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
